# Copy to backend/.env and edit. Everything is optional.

# auto = Gemini first, then local Ollama, then OpenRouter | gemini | ollama | openrouter
DIMORA_AI_PROVIDER=auto

# Main AI — Google Gemini. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional fallback — local AI (free, private): install Ollama, then `ollama pull qwen3.5:9b`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Optional fallback — OpenRouter: create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.5-27b

DIMORA_HOST=127.0.0.1
DIMORA_PORT=8000
DIMORA_AI_TIMEOUT=120
DIMORA_MAX_UPLOAD_MB=25

# --- Public website (set these on your host, e.g. Render → Environment) ---
# DIMORA_PUBLIC=1           rate-limits AI calls paid with your key; ignores visitor-supplied Ollama URLs
# DIMORA_AI_PER_HOUR=20     AI calls per visitor per hour (0 = unlimited)
# DIMORA_AI_PER_DAY=500     AI calls for the whole site per day (0 = unlimited)

# --- Accounts & saved homes ---
# Leave empty to use a SQLite file (backend/data/dimora.db) — fine on your own PC.
# On hosts that wipe the disk on restart (Render free), use a free Postgres database (neon.tech / supabase.com):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DIMORA_DB_PATH=backend/data/dimora.db
