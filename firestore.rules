rules_version = '2';
// DIMORA — Cloud Firestore security rules.
// Each signed-in user can read and write only their own folder: users/{uid} (profile & preferences)
// and users/{uid}/projects/{projectId} (+ /chunks/{n}) for their saved homes. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
